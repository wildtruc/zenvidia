#: ./zenvidia-test23:510
msgid ""
"$(cat <<-WRN\n"
"${r}KERNEL ALERT${end}\n"
"${v}Driver's ${y}${drv_model[@]}${end} source code for ${j}$(new_version)${end} is known to having issues\n"
"with ${j}${KERNEL}${end} kernel and wont compile without errors.\n"
"\n"
"${exit_msg} using an older kernel instead.${end}${compat_list}\n"
"\n"
"WRN\n"
")"
msgstr ""
"$(cat <<-WRN\n"
"${r}ALERTE NOYAU{end}\n"
"${v}le code source du pilote ${y}${drv_model[@]}${end} pour ${j}$(new_version)${end} est connu comme\n"
"problématique pour le noyau ${j}${KERNEL}${end} et ne compilera pas sans erreurs.\n"
"\n"
"${exit_msg} l'usage d'un noyau antérieur à la place.${end}${compat_list}\n"
"\n"
"WRN\n"
")"
